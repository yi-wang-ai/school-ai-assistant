# Copy to .env and fill in. Never commit .env.
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=            # API key of the 报销政策助手 app (Dify → app → API Access)
DIFY_TEACH_KEY=          # optional: course Q&A app
DIFY_RESEARCH_KEY=       # optional: literature summary workflow
POSTGRES_PASSWORD=       # openssl rand -hex 16
SERVICE_TOKEN=           # openssl rand -hex 24; also set as secret env var SERVICE_TOKEN in the Dify app
# Added by: docker compose exec -T service uv run --no-dev python seed_users.py >> .env
